# thrash-protect configuration file (YAML format)
# Copy to /etc/thrash-protect.yaml and modify as needed
# Requires PyYAML: pip install PyYAML

thrash-protect:
  # Sleep interval between checks in seconds (default: 0.5)
  interval: 0.5

  # Number of swap pages to trigger action (default: auto-detected from the
  # swap storage type: 4 on HDD or unknown, 64 on SSD, 512 on zram)
  # swap_page_threshold: 4

  # Major page faults before process scan (default: swap_page_threshold * 4)
  # pgmajfault_scan_threshold: 16

  # Processes to protect from suspension
  # By default, includes shells from /etc/shells plus common terminals/WMs
  # cmd_whitelist:
  #   - sshd
  #   - bash
  #   - zsh
  #   - xinit
  #   - X
  #   - Xorg
  #   - sway
  #   - tmux
  #   - screen
  #   - foot
  #   - alacritty

  # Processes to prioritize for suspension
  # cmd_blacklist: []

  # Processes with job control - suspend parent too
  # By default, includes shells from /etc/shells plus sudo
  # cmd_jobctrllist:
  #   - bash
  #   - zsh
  #   - sudo

  # Score multiplier for blacklisted processes (default: 16)
  blacklist_score_multiplier: 16

  # Score divider for whitelisted processes (default: 64)
  whitelist_score_divider: 64

  # Ratio of stack pops vs queue pops when unfreezing (default: 5)
  # Lower = fairer, higher = more efficient
  unfreeze_pop_ratio: 5

  # Enable debug logging to stderr (default: false)
  debug_logging: false

  # Log warnings when processes are in unexpected states (default: false)
  debug_checkstate: false

  # Log detailed process info when freezing (default: false)
  # This spawns ps, so adds overhead during freeze
  log_user_data_on_freeze: false

  # Log detailed process info when unfreezing (default: true)
  log_user_data_on_unfreeze: true

  # Use human-readable date format in logs (default: true)
  # Set to false for Unix timestamps
  date_human_readable: true

  # Use PSI (Pressure Stall Information) to amplify swap-based thrash detection
  # Requires Linux 4.20+. When enabled, memory pressure amplifies the swap signal.
  # (default: true)
  # use_psi: true

  # PSI full avg10 threshold for amplification (default: 5.0)
  # At this value, swap sensitivity is doubled. Higher PSI = more amplification.
  # psi_threshold: 5.0

  # Minimum swap pages in each direction before PSI is allowed to amplify
  # (default: 2). Memory pressure also rises on page-cache refault, which is
  # not thrashing; without this floor it can amplify a one-page trickle past
  # the trigger. Raise it to make PSI amplification harder to reach.
  # psi_swap_floor: 2

  # Do not count pressure as thrashing when a saturated disk explains it on its
  # own (default: true). Suspending processes cannot fix an IO bottleneck.
  # io_pressure_veto: true

  # io full avg10 percentage at which the disk counts as saturated
  # (default: 50.0). Only consulted when io_pressure_veto is enabled.
  # io_pressure_threshold: 50.0

  # Absolute floor for OOM protection (default: 5.0).  The OOM predictor
  # only reacts to memory being consumed fast; a box sitting at the edge with
  # nothing moving is never caught by it.  So the biggest memory consumer is
  # also suspended whenever available memory plus weighted free swap drops
  # below this percentage of the (weighted) total and available memory is
  # below twice this percentage of RAM, trend or not - at most one per
  # oom_hold_ticks, up to oom_floor_max_frozen.  Set it to 0 on a box that
  # deliberately runs with full swap.
  # oom_floor_pct: 5.0

  # The same, but counting RAM only and only once swap is exhausted (or there
  # is no swap): suspend when MemAvailable is below this percentage of RAM.
  # (default: 0 = disabled)
  # oom_floor_mem_pct: 5

  # Processes the floor keeps suspended at most (default: 3).  Suspending
  # frees no memory, so beyond this the floor stops suspending and only holds
  # back releases until it clears, buying time for someone to step in.
  # 0 makes the floor hold releases without suspending anything.
  # oom_floor_max_frozen: 3

  # Pretend thrashing every 2^N iterations, for testing (default: 0 = disabled)
  # test_mode: 0
